{
  "version": "0.0.0",
  "name": "@frameless/-plugin-tiptap-editor",
  "description": "A Strapi plugin that integrates the Tiptap editor for rich text editing capabilities.",
  "license": "EUPL-1.2",
  "author": "Frameless.io",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:frameless/kennisbank.git",
    "directory": "packages/strapi-plugin-tiptap-editor"
  },
  "keywords": [
    "strapi-plugin",
    "tiptap",
    "editor",
    "wysiwyg",
    "rich-text-editor",
    "strapi"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "run -T tsc -p admin/tsconfig.json",
    "test:ts:back": "run -T tsc -p server/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint-build": "tsc --noEmit",
    "lint-fix": "eslint . --max-warnings 0 --fix",
    "clean": "rimraf .next .strapi dist"
  },
  "dependencies": {
    "@strapi/design-system": "2.0.0-rc.27",
    "@strapi/icons": "2.0.0-rc.27",
    "@tiptap/react": "2.24.0",
    "@tiptap/starter-kit": "2.24.0",
    "react-intl": "7.1.11"
  },
  "devDependencies": {
    "@frameless/eslint-config": "workspace:*",
    "@frameless/typescript-config": "workspace:*",
    "@strapi/sdk-plugin": "5.3.2",
    "@strapi/strapi": "5.17.0",
    "@strapi/typescript-utils": "5.17.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "styled-components": "6.1.19",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@strapi/sdk-plugin": "^5.3.2",
    "@strapi/strapi": "^5.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "styled-components": "^6.1.19"
  },
  "strapi": {
    "kind": "plugin",
    "name": "tiptap-editor",
    "displayName": "tiptap-editor",
    "description": "A Strapi plugin that integrates the Tiptap editor for rich text editing capabilities."
  }
}
